		"nitro": "3.0.261103-rc",
		"pg": "^8.23.1",
		"posthog-js": "1.450.0",
		"posthog-node": "6.0.2",
		"radix-ui": "^1.8.1",
		"react": "^19.3.1",
		"react-day-picker": "^10.0.2",
		"react-dom": "^19.3.1",
		"react-email": "^6.11.13",
		"recharts": "^3.10.1",
		"resend": "^6.38.1",
		"sanitize-html": "^2.18.2",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"uqr": "^0.1.3",
		"web-vitals": "^6.2.3",
		"zod": "^4.6.7"
	},
	"devDependencies": {
