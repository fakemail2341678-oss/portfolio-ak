{
	"name": "start-template",
	"private": true,
	"type": "module",
	"scripts": {
		"setup:local": "node scripts/setup-local.ts",
		"diagnose": "node scripts/diagnose.ts",
		"dev": "node scripts/lib/dev-messages.ts && vite dev --port 3000",
		"dev:local": "node scripts/dev-local.ts",
		"dev:offline": "node scripts/dev-offline.ts",
		"build": "vite build",
		"start": "node --env-file-if-exists=.env .output/server/index.mjs",
		"preview": "vite preview",
		"typecheck": "pnpm i18n:compile && node node_modules/typescript7/bin/tsc --noEmit --checkers 2 --incremental --tsBuildInfoFile node_modules/.cache/tsc/tsbuildinfo7",
		"check": "biome check --error-on-warnings",
		"check:fix": "biome check --write",
		"knip": "knip",
		"test": "vitest run --project unit --project components --project server",
		"test:watch": "vitest --project unit --project components --project server",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:check": "drizzle-kit check",
		"db:studio": "drizzle-kit studio",
		"storybook": "storybook dev -p 6006 --no-open",
		"build-storybook": "storybook build",
		"i18n:compile": "node scripts/i18n-compile.ts",
		"i18n:translate": "inlang machine translate --project ./project.inlang --locale en --targetLocales ne",
		"i18n:check": "inlang check --project ./project.inlang --missing-translations --empty-translations --empty-variants --missing-variables --unknown-variables --missing-markup --missing-variants --missing-selectors",
		"db:seed-admin": "node scripts/seed-admin.ts",
		"db:seed-demo": "node scripts/seed-demo.ts",
		"db:seed-portfolio": "node scripts/seed-portfolio.ts",
		"db:seed-taskline": "node scripts/seed-taskline.ts",
		"db:seed-kharcha": "node scripts/seed-kharcha.ts",
		"tmdb:record": "node scripts/record-tmdb-fixtures.ts",
		"parda:probe": "node scripts/probe-sources.ts",
		"lichess:record": "node scripts/record-lichess-fixtures.ts",
		"chaal:sounds": "node scripts/chaal-sounds.ts",
		"engine:copy": "node scripts/engine-copy.ts",
		"auth:schema": "auth generate --config src/server/auth/auth.ts --output src/server/db/schema/auth.ts --yes && biome format --write src/server/db/schema/auth.ts",
		"test:storybook": "node scripts/test-storybook.ts",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"standard": "node scripts/standard.ts",
		"gates": "node scripts/gates.ts",
		"gates:clean": "node scripts/gates.ts --clean",
		"test:coverage": "vitest run --project unit --project components --project server --coverage && node scripts/coverage-report.ts",
		"new:feature": "node scripts/new-feature.ts",
		"strip-demo": "node scripts/strip-demo.ts",
		"prepare": "node scripts/install-hooks.mjs"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "^1.7.25",
		"@dnd-kit/dom": "0.5.3",
